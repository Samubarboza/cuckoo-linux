# Maintainer: Samubarboza <samubjunior95@gmail.com>

pkgname=cuckoo-desktop
pkgver=1.4.0
pkgrel=1
pkgdesc="Desktop settings for Cuckoo Linux"
arch=('any')
url="https://github.com/Samubarboza/cuckoo-linux"
license=('GPL-3.0-or-later')
depends=('quickshell' 'swaync'                       # the bar with its popups, and the notifications
         'hyprlock' 'hypridle'                       # the lock screen, and the idle timer that starts it
         'upower'                                    # battery level
         'power-profiles-daemon'                     # the power modes in the battery popup
         'brightnessctl'                             # the brightness slider
         'qt6-svg'                                   # draws the svg app icons
         'papirus-icon-theme' 'hicolor-icon-theme'   # the only icon theme, and its base
         'gsettings-desktop-schemas'                 # makes papirus the icon theme of the gtk apps
         'ttf-jetbrains-mono-nerd' 'adwaita-fonts'   # the bar lines up with these fonts
         'noto-fonts-emoji'                          # the weather icon is an emoji
         'plymouth'                                  # the boot splash
         'starship' 'atuin' 'bash-preexec')          # the bash prompt and history

# config goes to /etc/skel, the folder every new user starts with.
# system goes to the root of the disk.
package() {
    install -d -m 0755 -- "${pkgdir}/etc/skel/.config"
    # Files come from the package folder because this package lives in the repository (see AGENTS.md)
    cp -r --no-preserve=ownership -- "${startdir}/config/." "${pkgdir}/etc/skel/.config/"
    cp -r --no-preserve=ownership -- "${startdir}/system/." "${pkgdir}/"
    chmod -R u=rwX,go=rX -- "${pkgdir}/etc" "${pkgdir}/usr"
}
