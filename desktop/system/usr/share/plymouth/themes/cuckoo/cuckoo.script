# Cuckoo boot splash: the full-screen image with a thin bar that fills as it boots.

screen_width = Window.GetWidth();
screen_height = Window.GetHeight();

# Background image, scaled to fill the screen
background = Image("cuckoo-splash.png").Scale(screen_width, screen_height);
background_sprite = Sprite(background);
background_sprite.SetPosition(0, 0, -10);

# Thin bar centered, a little below the logo
bar_width = screen_width / 6;
bar_height = 2;
bar_x = (screen_width - bar_width) / 2;
bar_y = screen_height * 0.57;

# One white pixel scaled into the bar. The track stays dim, the fill is bright.
pixel = Image("bar.png");

track_sprite = Sprite(pixel.Scale(bar_width, bar_height));
track_sprite.SetPosition(bar_x, bar_y, 1);
track_sprite.SetOpacity(0.25);

fill_sprite = Sprite();
fill_sprite.SetPosition(bar_x, bar_y, 2);

# Grow the fill from left to right with the boot progress
fun on_boot_progress(duration, progress) {
    fill_width = bar_width * progress;
    if (fill_width < 1) {
        fill_width = 1;
    }
    fill_sprite.SetImage(pixel.Scale(fill_width, bar_height));
}

Plymouth.SetBootProgressFunction(on_boot_progress);
