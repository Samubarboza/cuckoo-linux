#!/usr/bin/env bash
#
# SPDX-License-Identifier: GPL-3.0-or-later
#
# Install Cuckoo Linux with the answers from cuckoo-configurator.
# It erases the chosen disk, so it asks nothing: the questions were asked before.

set -e -u

answers_dir="${CUCKOO_ANSWERS_DIR:-/tmp/cuckoo}"
target_dir="${CUCKOO_TARGET_DIR:-/mnt}"
log_file="${answers_dir}/install.log"
recovery_key_file="${answers_dir}/recovery-key"
hardware_script="/usr/local/bin/cuckoo-hardware"
hardware_fixes_dir="/usr/local/share/cuckoo/hardware"
boot_files_dir="/usr/local/share/cuckoo/boot"
machine_key_name="Cuckoo Linux Machine Key"
machine_key_dir="/var/lib/cuckoo/secureboot"
desktop_packages_dir="/usr/local/share/cuckoo/packages"
package_list_file="/usr/local/share/cuckoo/offline-packages.txt"
target_mirrorlist_file="/usr/local/share/cuckoo/mirrorlist"
docker_settings_file="/usr/local/share/cuckoo/docker-daemon.json"
logo_file="/usr/local/share/cuckoo/logo.txt"
logo_big_file="/usr/local/share/cuckoo/logo-big.txt"
esp_size="4GiB"
btrfs_mount_options="noatime,compress=zstd"
bar_width=26
total_steps=14
steps_done=0
packages_total=0
# Where the interface block starts. The defaults draw it at the top left, so if the screen size can not be read nothing breaks.
screen_top_row=1
left_pad=''
screen_cols=0
logo_centered=''
# Colors. The console has only 16, so one palette slot gets the exact lavender
color_accent=$'\033[35m'
color_text=$'\033[37m'
color_dim=$'\033[90m'
color_reset=$'\033[0m'

# The same list installs the system and counts the packages for the progress bar.
# It is the same file the offline repo is built from, so build and install match.
if [[ ! -f "${package_list_file}" ]]; then
  printf 'ERROR: %s was not found.\n' "${package_list_file}" >&2
  exit 1
fi
mapfile -t base_packages < <(grep -vE '^[[:space:]]*#|^[[:space:]]*$' "${package_list_file}")

# The log lives in memory and is lost on reboot, so keep a copy on the disk
save_log_to_disk() {
  if [[ -d "${target_dir}/var/log" ]]; then
    cp -- "${log_file}" "${target_dir}/var/log/cuckoo-install.log" 2>/dev/null || true
  fi
  # Write everything to the disk now, so turning off the computer loses nothing
  sync
}

fail() {
  save_log_to_disk
  # Keep the logo centered on top, like the other screens
  {
    printf '\033[2J\033[%s;1H' "${screen_top_row}"
    [[ -n "${logo_centered}" ]] && printf '%s%s%s\n\n' "${color_accent}" "${logo_centered}" "${color_reset}"
    print_centered_line "ERROR: $1" "${color_text}"
    print_centered_line "The details are in ${log_file}" "${color_text}"
  } >&2
  exit 1
}

format_elapsed_time() {
  if (($1 < 60)); then
    printf '%ss' "$1"
  else
    printf '%sm %02ss' "$(($1 / 60))" "$(($1 % 60))"
  fi
}

# Ask pacman how many packages this install needs. It downloads nothing, only asks.
# A total that does not come out leaves the bar as it was, the install goes on.
count_target_packages() {
  local counted=0
  if pacman -Sy &>/dev/null; then
    counted="$(pacman -Sp --print-format '%n' -- "${base_packages[@]}" 2>/dev/null | sort -u | wc -l)"
  fi
  if ((counted < 30 || counted > 2000)); then
    counted=0
  fi
  printf '%s' "${counted}"
}

# How far the base system got, from 0 to 100. Each installed package leaves
# a folder on the disk, so counting them is enough and it never goes back.
base_system_percent() {
  local installed
  if ((packages_total == 0)); then
    printf '0'
    return 0
  fi
  installed="$(find "${target_dir}/var/lib/pacman/local" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | wc -l)"
  if ((installed > packages_total)); then
    installed="${packages_total}"
  fi
  printf '%s' "$((installed * 100 / packages_total))"
}

# Read the screen size. Try tput first, then stty. Empty if neither works.
read_screen_size() {
  local height width size
  height="$(tput lines 2>/dev/null || true)"
  width="$(tput cols 2>/dev/null || true)"
  if [[ ! "${height}" =~ ^[0-9]+$ || ! "${width}" =~ ^[0-9]+$ ]]; then
    size="$(stty size 2>/dev/null || true)"
    height="${size% *}"
    width="${size#* }"
  fi
  [[ "${height}" =~ ^[0-9]+$ && "${width}" =~ ^[0-9]+$ ]] || return 1
  printf '%s %s' "${height}" "${width}"
}

# Measure the screen once and set where the interface block starts, so it stays
# centered. The logo is the widest part, so it anchors the horizontal margin.
# If there is no logo or the size can not be read, it stays at the top left.
center_interface() {
  [[ -n "${logo}" ]] || return 0
  local size
  size="$(read_screen_size)" || return 0
  local screen_width="${size#* }"
  screen_cols="${screen_width}"

  local logo_width=0 line
  while IFS= read -r line; do
    if ((${#line} > logo_width)); then logo_width="${#line}"; fi
  done <<<"${logo}"

  # A small top margin, like the configurator, so the block sits near the top
  local left_margin=$(((screen_width - logo_width) / 2))
  local top_margin=2
  if ((left_margin < 0)); then left_margin=0; fi

  screen_top_row=$((top_margin + 1))
  printf -v left_pad '%*s' "${left_margin}" ''

  # Indent every logo line with the same margin, so it stays a block
  logo_centered=''
  while IFS= read -r line; do
    logo_centered+="${left_pad}${line}"$'\n'
  done <<<"${logo}"
  logo_centered="${logo_centered%$'\n'}"
}

# The console has only 16 colors, so set one palette slot to the exact lavender
setup_palette() {
  printf '\033]P5B4BEFE'
}

# Print one line centered on the screen, in the given color. With no measured
# width it stays at the left.
print_centered_line() {
  local text="$1" color="${2:-}" pad=0
  if ((screen_cols > ${#text})); then pad=$(((screen_cols - ${#text}) / 2)); fi
  printf '%*s%s%s%s\n' "${pad}" '' "${color}" "${text}" "${color_reset}"
}

# Print already-colored content centered using its visible width, then clear the
# rest of the line. The width is given because color codes take no space.
print_at_center() {
  local visible_width="$1" content="$2" pad=0
  if ((screen_cols > visible_width)); then pad=$(((screen_cols - visible_width) / 2)); fi
  printf '%*s%s\033[K' "${pad}" '' "${content}"
}

# Draw the whole screen again from the top, without clearing it first.
# Each line erases what was there, so the logo stays still and nothing blinks.
draw_screen() {
  local title="$1" elapsed="$2" last_line="$3" percent="$4"
  local block filled_blocks filled='' empty='' bar disk_line percent_text elapsed_text title_line

  filled_blocks=$((percent * bar_width / 100))
  for ((block = 0; block < bar_width; block++)); do
    if ((block < filled_blocks)); then filled+='▓'; else empty+='░'; fi
  done
  bar="${color_accent}${filled}${color_dim}${empty}${color_reset}"

  printf '\033[%s;1H' "${screen_top_row}"
  [[ -n "${logo_centered}" ]] && printf '%s%s%s\n\n' "${color_accent}" "${logo_centered}" "${color_reset}"

  # Each line centers on its own width, so they sit symmetric under the logo
  disk_line="Installing on ${disk}"
  print_at_center "${#disk_line}" "${color_text}${disk_line}${color_reset}"
  printf '\n\n'

  # The percent is fixed to 3 places so the bar line never shifts
  printf -v percent_text '%3s' "${percent}"
  print_at_center "$((bar_width + 6))" "${bar}  ${color_text}${percent_text}%${color_reset}"
  printf '\n\n'

  # The time is fixed to 7 places so the title line never shifts
  printf -v elapsed_text '%7s' "$(format_elapsed_time "${elapsed}")"
  title_line="${title}  ${elapsed_text}"
  print_at_center "${#title_line}" "${color_text}${title_line}${color_reset}"
  printf '\n'

  # The log line centers on a fixed width so it does not jump as it changes
  print_at_center 60 "${color_dim}${last_line}${color_reset}"
  printf '\033[J'
}

# Run a long command and keep the screen moving: the progress bar, the time it takes
# and the last line of its output. The whole output stays in the log.
run_step() {
  local may_fail=0 progress_command=''
  while [[ "$1" == --* ]]; do
    case "$1" in
      --may-fail)
        may_fail=1
        shift
        ;;
      --progress)
        progress_command="$2"
        shift 2
        ;;
      *)
        fail "Unknown run_step option: $1"
        ;;
    esac
  done
  local title="$1" start_time="${SECONDS}" last_line step_percent step_pid
  shift

  "$@" >>"${log_file}" 2>&1 </dev/null &
  step_pid=$!

  while kill -0 "${step_pid}" 2>/dev/null; do
    last_line="$(tail -1 -- "${log_file}" 2>/dev/null \
      | sed -E 's/\x1b\[[0-9;]*[a-zA-Z]//g' | tr -d '\r' | cut -c1-60)"
    step_percent=0
    if [[ -n "${progress_command}" ]]; then
      step_percent="$("${progress_command}")"
    fi
    draw_screen "${title}" "$((SECONDS - start_time))" "${last_line}" \
      "$(((steps_done * 100 + step_percent) / total_steps))"
    sleep 0.3
  done

  if ! wait "${step_pid}"; then
    ((may_fail)) && return 1
    fail "${title} failed."
  fi
  steps_done=$((steps_done + 1))
  draw_screen "${title}" "$((SECONDS - start_time))" '' "$((steps_done * 100 / total_steps))"
}

read_answer() {
  local answer_file="${answers_dir}/$1"
  [[ -r "${answer_file}" ]] || fail "the answer '$1' is missing. Run cuckoo-configurator first."
  <"${answer_file}" head -1
}

# Read the new partitions from the disk instead of guessing their names.
# The disk was just erased, so they come in the order they were created.
find_partitions() {
  local try=0 partitions=()
  partprobe -- "${disk}" &>/dev/null || true
  while ((try++ < 10)); do
    udevadm settle &>/dev/null || true
    mapfile -t partitions < <(lsblk --list --noheadings --output PATH -- "${disk}" | tail -n +2)
    esp_partition="${partitions[0]:-}"
    root_partition="${partitions[1]:-}"
    [[ -b "${esp_partition}" && -b "${root_partition}" ]] && return 0
    sleep 1
  done
  fail 'the new partitions were not found.'
}

prepare_disk() {
  sgdisk --zap-all -- "${disk}"
  sgdisk --new="1:0:+${esp_size}" --typecode=1:ef00 --change-name=1:CUCKOO_ESP \
    --new=2:0:0 --typecode=2:8304 --change-name=2:CUCKOO_ROOT -- "${disk}"
  udevadm settle
}

format_disk() {
  wipefs --all -- "${esp_partition}" "${root_partition}"
  mkfs.fat -F 32 -n CUCKOO_ESP -- "${esp_partition}"
  # printf is part of bash, so the password is not shown in the process list
  if [[ -n "${disk_encryption_on}" ]]; then
    printf '%s' "${password}" | cryptsetup luksFormat --type luks2 --batch-mode --key-file - "${root_partition}"
    printf '%s' "${password}" | cryptsetup open --key-file - "${root_partition}" root
  fi
  mkfs.btrfs -f -L CUCKOO -- "${root_device}"
}

# A key that opens the disk when the password can not. It goes only to a root file:
# the key and its QR code never reach the log.
create_recovery_key() {
  (umask 077 && PASSWORD="${password}" systemd-cryptenroll --recovery-key "${root_partition}" >"${recovery_key_file}" 2>/dev/null)
  [[ -s "${recovery_key_file}" ]]
}

mount_disk() {
  local btrfs_subvolume mount_point
  # Each subvolume and its folder. The root goes first, the others are mounted inside it.
  local btrfs_subvolumes=(
    '@:/'
    '@home:/home'
    '@log:/var/log'
    '@pkg:/var/cache/pacman/pkg'
    '@snapshots:/.snapshots'
    '@docker:/var/lib/docker'
    '@containerd:/var/lib/containerd'
  )
  # Always say the file system, otherwise mount tries others first and the screen fills with errors
  mount -t btrfs -- "${root_device}" "${target_dir}"
  for btrfs_subvolume in "${btrfs_subvolumes[@]}"; do
    btrfs subvolume create "${target_dir}/${btrfs_subvolume%%:*}"
  done
  umount -- "${target_dir}"

  for btrfs_subvolume in "${btrfs_subvolumes[@]}"; do
    mount_point="${target_dir}${btrfs_subvolume#*:}"
    mkdir -p -- "${mount_point}"
    mount -t btrfs -o "${btrfs_mount_options},subvol=${btrfs_subvolume%%:*}" -- "${root_device}" "${mount_point}"
  done
  chmod 0700 -- "${target_dir}/.snapshots"
  mkdir -p -- "${target_dir}/boot"
  mount -t vfat -o fmask=0077,dmask=0077 -- "${esp_partition}" "${target_dir}/boot"
}

write_archinstall_files() {
  local packages_json
  packages_json="$(printf '"%s",' "${base_packages[@]}")"
  packages_json="[${packages_json%,}]"

  cat >"${answers_dir}/archinstall.json" <<EOF
{
  "disk_config": { "config_type": "pre_mounted_config", "mountpoint": "${target_dir}" },
  "bootloader_config": { "bootloader": "No bootloader", "uki": false, "removable": false },
  "hostname": "cuckoo",
  "kernels": ["linux"],
  "locale_config": { "kb_layout": "${keymap}", "sys_lang": "${locale}", "sys_enc": "UTF-8" },
  "network_config": { "type": "nm" },
  "ntp": true,
  "packages": ${packages_json},
  "profile_config": null,
  "services": ["bluetooth", "docker", "power-profiles-daemon", "ufw"],
  "swap": { "enabled": true, "algorithm": "zstd" },
  "timezone": "${timezone}"
}
EOF

  # json escapes the quotes and backslashes of the password, a plain text file does not.
  # The values go in the environment, so they are not shown in the process list.
  CUCKOO_USERNAME="${username}" CUCKOO_PASSWORD="${password}" python3 -c '
import json, os
user = {"username": os.environ["CUCKOO_USERNAME"], "!password": os.environ["CUCKOO_PASSWORD"], "sudo": True}
print(json.dumps({"!users": [user]}, indent=2))
' >"${answers_dir}/credentials.json" || fail 'the user settings could not be written.'
  chmod 600 -- "${answers_dir}/credentials.json"
}

# The key of this computer. It signs everything that shim starts.
create_machine_key() {
  install -d -m 0700 -- "${target_dir}${machine_key_dir}"
  arch-chroot "${target_dir}" openssl req -new -x509 -newkey rsa:2048 -nodes -sha256 -days 36500 \
    -subj "/CN=${machine_key_name}/" -addext extendedKeyUsage=codeSigning \
    -keyout "${machine_key_dir}/MOK.key" -out "${machine_key_dir}/MOK.crt"
  chmod 0600 -- "${target_dir}${machine_key_dir}/MOK.key"
  arch-chroot "${target_dir}" openssl x509 -in "${machine_key_dir}/MOK.crt" -outform DER -out "${machine_key_dir}/MOK.cer"
  install -m 0644 -- "${target_dir}${machine_key_dir}/MOK.cer" "${target_dir}/boot/MOK.cer"
}

# shim starts systemd-boot, and systemd-boot shows one boot image for each menu entry
configure_boot() {
  local root_uuid luks_uuid luks_options kernel_options
  install -Dm 644 -- "${boot_files_dir}/linux.preset" "${target_dir}/etc/mkinitcpio.d/linux.preset"
  install -Dm 644 -- "${boot_files_dir}/mkinitcpio.conf" "${target_dir}/etc/mkinitcpio.conf.d/cuckoo.conf"
  install -Dm 644 -t "${target_dir}/etc/kernel/" -- "${boot_files_dir}"/os-release{,-safe-video,-fallback}
  install -Dm 644 -- "${boot_files_dir}/loader.conf" "${target_dir}/boot/loader/loader.conf"
  install -Dm 755 -t "${target_dir}/usr/local/bin/" -- /usr/local/bin/cuckoo-install-boot-file
  install -Dm 755 -t "${target_dir}/etc/initcpio/post/" -- "${boot_files_dir}/cuckoo-install-uki"
  install -Dm 644 -t "${target_dir}/etc/pacman.d/hooks/" -- "${boot_files_dir}/cuckoo-systemd-boot.hook"

  root_uuid="$(blkid -s UUID -o value -- "${root_device}")"
  kernel_options="root=UUID=${root_uuid} rootflags=subvol=@ rw rootfstype=btrfs zswap.enabled=0 loglevel=3 quiet splash plymouth.ignore-serial-consoles vt.global_cursor_default=0 fbcon=nodefer"
  if [[ -n "${disk_encryption_on}" ]]; then
    luks_uuid="$(blkid -s UUID -o value -- "${root_partition}")"
    luks_options="rd.luks.name=${luks_uuid}=root"
    if [[ -n "${tpm_unlock}" ]]; then
      luks_options+=" rd.luks.options=tpm2-device=auto"
    fi
    kernel_options="${luks_options} ${kernel_options}"
  fi
  printf '%s\n' "${kernel_options}" >"${target_dir}/etc/kernel/cmdline"
  printf '%s nomodeset\n' "${kernel_options}" >"${target_dir}/etc/kernel/cmdline-safe-video"
  # The root line of fstab, without its subvolume
  sed -E -i '/^[^#[:space:]]+[[:space:]]+\/[[:space:]]/ { s/,subvolid=[0-9]+//; s/,subvol=\/@([,[:space:]])/\1/ }' \
    "${target_dir}/etc/fstab"

  rm -f -- "${target_dir}/boot/initramfs-linux.img"
  install -Dm 644 -- "${boot_files_dir}/shimx64.efi" "${target_dir}/boot/EFI/BOOT/BOOTX64.EFI"
  install -m 644 -- "${boot_files_dir}/mmx64.efi" "${target_dir}/boot/EFI/BOOT/mmx64.efi"
  arch-chroot "${target_dir}" /usr/local/bin/cuckoo-install-boot-file \
    /usr/lib/systemd/boot/efi/systemd-bootx64.efi /boot/EFI/BOOT/grubx64.efi
  install -d -- "${target_dir}/boot/EFI/Linux"
  arch-chroot "${target_dir}" mkinitcpio -P
}

# One Cuckoo entry in the boot menu of the computer. Entries of other disks stay.
configure_boot_entry() {
  local old_partition_uuid boot_number
  for old_partition_uuid in "${old_partition_uuids[@]}"; do
    while read -r boot_number; do
      efibootmgr --quiet --delete-bootnum --bootnum "${boot_number}" || return 1
    done < <(efibootmgr --verbose | grep -i -F -- "${old_partition_uuid}" | sed -n 's/^Boot\([0-9A-Fa-f]\{4\}\).*/\1/p')
  done
  efibootmgr --create --disk "${disk}" --part 1 --label Cuckoo --loader '\EFI\BOOT\BOOTX64.EFI'
}

has_tpm2() {
  systemd-analyze has-tpm2 &>/dev/null
}

is_secure_boot_on() {
  mokutil --sb-state 2>/dev/null | grep -q 'SecureBoot enabled'
}

# 8 letters that sit in the same place on QWERTY, AZERTY and QWERTZ keyboards
create_key_enrollment_code() {
  local code_letters='bcdefghjknprstuvx' enrollment_code='' letter_number
  for ((letter_number = 0; letter_number < 8; letter_number++)); do
    enrollment_code+="${code_letters:SRANDOM%${#code_letters}:1}"
  done
  printf '%s' "${enrollment_code}"
}

# Ask the blue screen to trust the key of this computer and to remove the keys of old installs
request_key_enrollment() {
  local temporary_dir hash_file exported_key old_keys=()
  mokutil --revoke-import &>/dev/null || true
  mokutil --revoke-delete &>/dev/null || true
  temporary_dir="$(mktemp -d -p "${answers_dir}")" || return 1
  trap 'rm -rf -- "${temporary_dir}"' EXIT

  (cd -- "${temporary_dir}" && mokutil --export) || true
  for exported_key in "${temporary_dir}"/*.der; do
    if [[ "$(openssl x509 -inform DER -in "${exported_key}" -noout -subject 2>/dev/null)" == "subject=CN=${machine_key_name}" ]]; then
      old_keys+=("${exported_key}")
    fi
  done

  hash_file="${temporary_dir}/password-hash"
  (umask 077 && printf '%s\n' "${key_enrollment_code}" | openssl passwd -6 -stdin >"${hash_file}") || return 1
  mokutil --import "${target_dir}${machine_key_dir}/MOK.cer" --hash-file "${hash_file}" || return 1
  if ((${#old_keys[@]} > 0)); then
    mokutil --delete "${old_keys[@]}" --hash-file "${hash_file}" || return 1
  fi
}

if ((EUID != 0)); then
  printf 'ERROR: run this as root.\n' >&2
  exit 1
fi

disk="$(read_answer disk)"
keymap="$(read_answer keymap)"
locale="$(read_answer locale)"
username="$(read_answer username)"
password="$(read_answer password)"
timezone="$(read_answer timezone)"
disk_encryption_on=''
if [[ -f "${answers_dir}/disk_encryption" ]]; then
  disk_encryption_on='yes'
fi

[[ -b "${disk}" ]] || fail "'${disk}' is not a disk."
if findmnt --source "${disk}" &>/dev/null || findmnt "${disk}"* &>/dev/null || [[ -e /dev/mapper/root ]]; then
  fail "'${disk}' is in use. Reboot and try again."
fi

esp_partition=""
root_partition=""
root_device=""

secure_boot_on=''
key_enrollment_code=''
if is_secure_boot_on; then
  secure_boot_on='yes'
  total_steps=$((total_steps + 1))
  key_enrollment_code="$(create_key_enrollment_code)"
fi
# The recovery key and the encrypted disk settings
if [[ -n "${disk_encryption_on}" ]]; then
  total_steps=$((total_steps + 2))
fi
# The TPM opens the disk only with encryption, Secure Boot and a TPM 2.0 chip
tpm_unlock=''
if [[ -n "${disk_encryption_on}" && -n "${secure_boot_on}" ]] && has_tpm2; then
  tpm_unlock='yes'
  total_steps=$((total_steps + 1))
fi

logo=''
[[ -f "${logo_big_file}" ]] && logo="$(<"${logo_big_file}")"
# Default to the raw logo, then center it if the screen can be measured
logo_centered="${logo}"
center_interface

: >"${log_file}"
# A key from an earlier try must never show up on the final screen
rm -f -- "${recovery_key_file}"
printf '\033[2J\033[H'
setup_palette

# Partitions of an old install on this disk
mapfile -t old_partition_uuids < <(lsblk --noheadings --output PARTUUID -- "${disk}" | grep -v '^$')

run_step 'Preparing the disk' prepare_disk
find_partitions
# The system goes inside the encrypted disk, or right on the partition
if [[ -n "${disk_encryption_on}" ]]; then
  root_device='/dev/mapper/root'
else
  root_device="${root_partition}"
fi
run_step 'Formatting the disk' format_disk
if [[ -n "${disk_encryption_on}" ]]; then
  run_step 'Creating the recovery key' create_recovery_key
fi
run_step 'Mounting the disk' mount_disk
write_archinstall_files
packages_total="$(count_target_packages)"
# setsid leaves archinstall without a terminal, so it writes in the log and not on our screen.
# offline skips the internet check: without it archinstall asks for Wi-Fi on a screen nobody sees and waits forever.
# skip-ntp and skip-wkd avoid two waits that need internet, so an offline install never hangs.
# skip-boot lets archinstall install no boot loader.
run_step --progress base_system_percent 'Installing the base system' \
  setsid --wait archinstall --silent --offline --skip-ntp --skip-wkd --skip-boot --config "${answers_dir}/archinstall.json" --creds "${answers_dir}/credentials.json"
run_step 'Creating the signing key' create_machine_key
run_step 'Setting up the boot' configure_boot

# The computer also starts from the fallback path, so a failure only warns
boot_entry_warning=''
if ! run_step --may-fail 'Adding the boot entry' configure_boot_entry; then
  boot_entry_warning='yes'
fi

# The key also loads from the disk, so a failure only warns
key_enrollment_warning=''
if [[ -n "${secure_boot_on}" ]] && ! run_step --may-fail 'Preparing the Secure Boot key' request_key_enrollment; then
  key_enrollment_warning='yes'
fi

# The console login shows the normal logo; the installer screen uses the big one
if [[ -f "${logo_file}" ]]; then
  printf '%s\n\n' "$(<"${logo_file}")" >"${target_dir}/etc/issue"
fi

# The install reads from the offline repo, but the installed system updates from the
# internet, so give it the normal Arch repos and a mirror list that ships in the ISO.
configure_target_repos() {
  install -Dm 644 -- "${target_mirrorlist_file}" "${target_dir}/etc/pacman.d/mirrorlist" || return 1
  cat >"${target_dir}/etc/pacman.conf" <<'EOF' || return 1
[options]
HoldPkg     = pacman glibc
Architecture = auto
ParallelDownloads = 5
SigLevel    = Required DatabaseOptional
LocalFileSigLevel = Optional

[core]
Include = /etc/pacman.d/mirrorlist

[extra]
Include = /etc/pacman.d/mirrorlist
EOF
}

# The updates are not needed to boot, so a failure only warns
update_warning=''
if ! run_step --may-fail 'Setting up the updates' configure_target_repos; then
  update_warning='yes'
fi

# turn on ufw at boot. ufw enable here chane the ISO, not the disk
configure_firewall() {
  local ufw_settings="${target_dir}/etc/ufw/ufw.conf"
  [[ -f "${ufw_settings}" ]] || return 1
  sed -i 's/^ENABLED=.*/ENABLED=yes/' "${ufw_settings}" || return 1
  grep -qx 'ENABLED=yes' "${ufw_settings}"
}

# The system boots without it, so a failure only warns
firewall_warning=''
if ! run_step --may-fail 'Turning on the firewall' configure_firewall; then
  firewall_warning='yes'
fi

# Docker opens the container ports before the firewall, so they only listen on this computer
configure_docker() {
  install -Dm 644 -- "${docker_settings_file}" "${target_dir}/etc/docker/daemon.json"
}

# The system boots without it, so a failure only warns
docker_warning=''
if ! run_step --may-fail 'Setting up Docker' configure_docker; then
  docker_warning='yes'
fi

# Every line says what to do when it fails: inside a step, set -e does not stop the script
install_desktop_package() {
  pacman --root "${target_dir}" --dbpath "${target_dir}/var/lib/pacman" \
    --noconfirm -U -- "${desktop_packages_dir}"/{cuckoo-desktop,cuckoo-greeter}-[0-9]*.pkg.tar.zst || return 1
  # archinstall already made the user, so /etc/skel reached it too late
  arch-chroot "${target_dir}" cp -r --no-target-directory /etc/skel "/home/${username}" || return 1
  # The bash package owns .bashrc, so it only gets one line that loads the Cuckoo settings
  printf '\nsource /usr/share/cuckoo/bashrc.sh\n' >>"${target_dir}/home/${username}/.bashrc" || return 1
  arch-chroot "${target_dir}" chown -R "${username}:" "/home/${username}" || return 1
  # Only now, so a broken desktop leaves the plain console login working.
  # graphical.target is what pulls in the login screen, the console one does not.
  arch-chroot "${target_dir}" systemctl enable greetd.service || return 1
  arch-chroot "${target_dir}" systemctl set-default graphical.target || return 1
}

# The desktop is not needed to boot, so a failure only warns
desktop_warning=''
if ! run_step --may-fail 'Installing the desktop' install_desktop_package; then
  desktop_warning='yes'
fi

# A first start key inside the encrypted disk, and the service that connects the TPM
prepare_tpm_unlock() {
  local first_start_key="${target_dir}/var/lib/cuckoo/tpm-enroll.key"
  install -d -m 0700 -- "${target_dir}/var/lib/cuckoo"
  (umask 077 && head -c 64 /dev/urandom >"${first_start_key}")
  printf '%s' "${password}" | cryptsetup luksAddKey --key-file - "${root_partition}" "${first_start_key}"
  install -Dm 755 -t "${target_dir}/usr/local/bin/" -- /usr/local/bin/cuckoo-tpm-enroll
  install -Dm 644 -t "${target_dir}/etc/systemd/system/" -- "${boot_files_dir}/cuckoo-tpm-enroll.service"
  arch-chroot "${target_dir}" systemctl enable cuckoo-tpm-enroll.service
}

if [[ -n "${tpm_unlock}" ]]; then
  run_step 'Preparing the TPM' prepare_tpm_unlock
fi

# Without the TPM, the desktop starts right after the password at start
configure_disk_encryption() {
  arch-chroot "${target_dir}" systemctl disable fstrim.timer || return 1
  [[ -z "${tpm_unlock}" ]] || return 0
  printf '%s\n' "${username}" >"${target_dir}/etc/greetd/cuckoo-autologin" || return 1
  chmod 0644 -- "${target_dir}/etc/greetd/cuckoo-autologin"
}

# The system boots without it, so a failure only warns
disk_encryption_warning=''
if [[ -n "${disk_encryption_on}" ]] && ! run_step --may-fail 'Setting up the encrypted disk' configure_disk_encryption; then
  disk_encryption_warning='yes'
fi

# The splash is cosmetic: plymouth shows the Cuckoo theme while the system boots.
# A failure only means no splash, so it never stops the boot. The theme ships in
# the cuckoo-desktop package, which also pulls in plymouth.
configure_splash() {
  local mkinitcpio_conf="${target_dir}/etc/mkinitcpio.conf.d/cuckoo.conf"
  [[ -f "${mkinitcpio_conf}" ]] || return 1
  # Only touch the initramfs if plymouth is really installed, so a failed desktop
  # step can never leave a broken initramfs and an unbootable system
  [[ -f "${target_dir}/usr/lib/initcpio/install/plymouth" ]] || return 1
  # Add the plymouth hook right after systemd, only if missing (safe to run twice)
  if ! grep -q 'plymouth' "${mkinitcpio_conf}"; then
    sed -i '/^HOOKS=/ s/\bsystemd\b/systemd plymouth/' "${mkinitcpio_conf}" || return 1
  fi
  install -d -m 0755 -- "${target_dir}/etc/plymouth" || return 1
  printf '[Daemon]\nTheme=cuckoo\n' >"${target_dir}/etc/plymouth/plymouthd.conf" || return 1
  arch-chroot "${target_dir}" mkinitcpio -P
}

splash_warning=''
if ! run_step --may-fail 'Setting up the splash' configure_splash; then
  splash_warning='yes'
fi

install_hardware_drivers() {
  install -Dm 755 -- "${hardware_script}" "${target_dir}${hardware_script}"
  install -d -m 0755 -- "${target_dir}${hardware_fixes_dir}"
  install -m 0755 -- "${hardware_fixes_dir}"/*.sh "${target_dir}${hardware_fixes_dir}/"
  arch-chroot "${target_dir}" "${hardware_script}"
}

# The drivers are useful but not needed to boot, so a failure only warns
drivers_warning=''
if ! run_step --may-fail 'Installing your video drivers' install_hardware_drivers; then
  drivers_warning='yes'
fi

# The last step, so the install itself saves no snapshots
configure_snapshots() {
  install -Dm 755 -t "${target_dir}/usr/local/bin/" -- /usr/local/bin/cuckoo-snapshot /usr/local/bin/cuckoo-keep-snapshot || return 1
  install -Dm 644 -t "${target_dir}/etc/pacman.d/hooks/" -- "${boot_files_dir}/cuckoo-snapshot.hook"
}

# The system boots without snapshots, so a failure only warns
snapshots_warning=''
if ! run_step --may-fail 'Turning on snapshots' configure_snapshots; then
  snapshots_warning='yes'
fi

save_log_to_disk
# The data is already on the disk, so a failed unmount only goes to the log
umount -R -- "${target_dir}" >>"${log_file}" 2>&1 || true
if [[ -n "${disk_encryption_on}" ]]; then
  cryptsetup close root >>"${log_file}" 2>&1 || true
fi

# A clean screen for the last message, with the logo still centered on top
printf '\033[2J\033[%s;1H' "${screen_top_row}"
[[ -n "${logo_centered}" ]] && printf '%s%s%s\n\n' "${color_accent}" "${logo_centered}" "${color_reset}"
print_centered_line 'Done! Cuckoo Linux is installed.' "${color_text}"
print_centered_line 'Remove the USB drive.' "${color_text}"
printf '\n'
if [[ -s "${recovery_key_file}" ]]; then
  print_centered_line 'Write this recovery key down. It opens the disk if you forget your password.' "${color_text}"
  print_centered_line "$(<"${recovery_key_file}")" "${color_accent}"
  printf '\n'
  rm -f -- "${recovery_key_file}"
fi
if [[ -n "${desktop_warning}" ]]; then
  print_centered_line 'The desktop settings were not installed.' "${color_text}"
  printf '\n'
fi
if [[ -n "${drivers_warning}" ]]; then
  print_centered_line 'The video drivers were not installed.' "${color_text}"
  print_centered_line 'Run cuckoo-hardware as root after the first boot.' "${color_text}"
  printf '\n'
fi
if [[ -n "${boot_entry_warning}" ]]; then
  print_centered_line 'The boot entry was not created.' "${color_text}"
  print_centered_line 'The computer starts from the fallback path.' "${color_text}"
  printf '\n'
fi
if [[ -n "${update_warning}" ]]; then
  print_centered_line 'The update settings were not fully set.' "${color_text}"
  printf '\n'
fi
if [[ -n "${firewall_warning}" ]]; then
  print_centered_line 'The firewall was not turned on.' "${color_text}"
  printf '\n'
fi
if [[ -n "${docker_warning}" ]]; then
  print_centered_line 'The Docker ports are open to the network.' "${color_text}"
  printf '\n'
fi
if [[ -n "${splash_warning}" ]]; then
  print_centered_line 'The boot splash was not set up.' "${color_text}"
  printf '\n'
fi
if [[ -n "${disk_encryption_warning}" ]]; then
  print_centered_line 'The automatic login after the password at start was not set.' "${color_text}"
  printf '\n'
fi
if [[ -n "${snapshots_warning}" ]]; then
  print_centered_line 'Snapshots before updates were not turned on.' "${color_text}"
  printf '\n'
fi
if [[ -n "${secure_boot_on}" && -n "${key_enrollment_warning}" ]]; then
  print_centered_line 'Secure Boot is on, but the key could not be prepared.' "${color_text}"
  print_centered_line 'After the reboot, choose Enroll key from disk and pick MOK.cer.' "${color_text}"
  printf '\n'
elif [[ -n "${secure_boot_on}" ]]; then
  # The blue screen steps, in a centered block
  key_enrollment_lines=(
    'Secure Boot is on. After the reboot, a blue screen asks to trust this computer:'
    '1. Press any key.'
    '2. Choose Enroll MOK, then Continue and Yes.'
    "3. Type this code: ${key_enrollment_code}"
    '4. If it shows Delete MOK, do the same with the same code.'
    '5. Choose Reboot.'
  )
  for key_enrollment_line in "${key_enrollment_lines[@]}"; do
    print_at_center "${#key_enrollment_lines[0]}" "${color_text}${key_enrollment_line}${color_reset}"
    printf '\n'
  done
  printf '\n'
fi
if [[ -n "${tpm_unlock}" ]]; then
  print_centered_line 'The first start asks for your password. After that, the TPM chip opens the disk by itself.' "${color_text}"
  print_centered_line 'Your password opens the disk when the TPM can not.' "${color_text}"
  print_centered_line 'If it asks again (for example after a BIOS update), run: sudo cuckoo-tpm-enroll' "${color_text}"
  printf '\n'
elif [[ -n "${disk_encryption_on}" && -z "${secure_boot_on}" ]]; then
  print_centered_line 'Secure Boot is off, so the computer asks for your password at each start.' "${color_text}"
  printf '\n'
elif [[ -n "${disk_encryption_on}" ]]; then
  print_centered_line 'This computer has no TPM 2.0 chip, so it asks for your password at each start.' "${color_text}"
  printf '\n'
fi

if gum confirm 'Reboot now?' --affirmative 'Reboot now' --negative 'Go to the console'; then
  systemctl reboot
fi
