+/// Text shown inside the password box, in the language of the system
+pub fn password_placeholder() -> &'static str {
+    let locale = sys_locale::get_locale().unwrap_or_default();
+    if locale.starts_with("es") {
+        "Contraseña"
+    } else {
+        "Password"
+    }
+}
