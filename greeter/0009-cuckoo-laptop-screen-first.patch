+/// Whether the monitor is the screen built into a laptop.
+fn is_laptop_screen(monitor: &Monitor) -> bool {
+    monitor.connector().is_some_and(|name| {
+        LAPTOP_SCREEN_NAMES
+            .iter()
+            .any(|prefix| name.starts_with(prefix))
+    })
+}
