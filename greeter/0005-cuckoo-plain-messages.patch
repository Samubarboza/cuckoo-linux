diff --git a/src/gui/texts.rs b/src/gui/texts.rs
new file mode 100644
index 0000000..894770e
--- /dev/null
+++ b/src/gui/texts.rs
@@ -0,0 +1,23 @@
+// SPDX-FileCopyrightText: 2026 The Cuckoo Linux Authors
+//
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+//! Texts shown on the Cuckoo login screen, in the language of the system
+
+fn is_spanish() -> bool {
+    sys_locale::get_locale()
+        .unwrap_or_default()
+        .starts_with("es")
+}
+
+pub fn password_placeholder() -> &'static str {
+    if is_spanish() { "Contraseña" } else { "Password" }
+}
+
+pub fn wrong_password() -> &'static str {
+    if is_spanish() { "Contraseña incorrecta" } else { "Wrong password" }
+}
+
+pub fn login_failed() -> &'static str {
+    if is_spanish() { "No se pudo iniciar sesión" } else { "Could not log in" }
+}
