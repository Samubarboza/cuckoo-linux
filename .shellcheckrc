# Suggest explicitly using -n in `[ $var ]`
enable=avoid-nullary-conditions

# Suggest 'command -v' instead of 'which'
enable=deprecate-which

# Suggest quoting variables without metacharacters
enable=quote-safe-variables

# Require [[ and warn about [ in Bash/Ksh
enable=require-double-brackets

# Suggest a default *) case in every case
enable=add-default-case

# Suggest [[ a != b ]] instead of [[ ! a == b ]]
enable=avoid-negated-conditions

# Suggest 'file' instead of 'cat file |'
enable=useless-use-of-cat

# Require ${var} instead of $var
enable=require-variable-braces
